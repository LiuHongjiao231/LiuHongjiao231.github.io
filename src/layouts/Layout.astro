---
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - 刘红娇作品集</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="font-sans antialiased bg-white text-gray-900">
    <nav class="fixed top-0 w-full bg-white/80 backdrop-blur-md border-b border-gray-100 z-50">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-lg font-bold text-gray-900">刘红娇</a>
        <div class="hidden md:flex gap-6 text-sm">
          <a href="/" class:list={["hover:text-indigo-600 transition", currentPath === "/" ? "text-indigo-600 font-medium" : "text-gray-600"]}>首页</a>
          <a href="/about" class:list={["hover:text-indigo-600 transition", currentPath === "/about" ? "text-indigo-600 font-medium" : "text-gray-600"]}>关于我</a>
          <a href="/academic" class:list={["hover:text-indigo-600 transition", currentPath === "/academic" ? "text-indigo-600 font-medium" : "text-gray-600"]}>学术研究</a>
          <a href="/marketing" class:list={["hover:text-indigo-600 transition", currentPath === "/marketing" ? "text-indigo-600 font-medium" : "text-gray-600"]}>营销作品</a>
          <a href="/skills" class:list={["hover:text-indigo-600 transition", currentPath === "/skills" ? "text-indigo-600 font-medium" : "text-gray-600"]}>技能特长</a>
        </div>
        <button id="menu-toggle" class="md:hidden text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
      <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
        <div class="px-4 py-3 flex flex-col gap-3 text-sm">
          <a href="/" class:list={["py-1", currentPath === "/" ? "text-indigo-600 font-medium" : "text-gray-600"]}>首页</a>
          <a href="/about" class:list={["py-1", currentPath === "/about" ? "text-indigo-600 font-medium" : "text-gray-600"]}>关于我</a>
          <a href="/academic" class:list={["py-1", currentPath === "/academic" ? "text-indigo-600 font-medium" : "text-gray-600"]}>学术研究</a>
          <a href="/marketing" class:list={["py-1", currentPath === "/marketing" ? "text-indigo-600 font-medium" : "text-gray-600"]}>营销作品</a>
          <a href="/skills" class:list={["py-1", currentPath === "/skills" ? "text-indigo-600 font-medium" : "text-gray-600"]}>技能特长</a>
        </div>
      </div>
    </nav>

    <main class="pt-16 min-h-screen">
      <slot />
    </main>

    <footer class="bg-gray-900 text-gray-300 py-12">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <p class="text-sm mb-2">THANKS FOR WATCHING</p>
        <p class="text-lg font-bold text-white mb-4">刘红娇</p>
        <div class="flex justify-center gap-4 text-sm mb-4">
          <a href="mailto:1305813321@qq.com" class="hover:text-white transition">1305813321@qq.com</a>
          <span class="text-gray-600">|</span>
          <span>15823763978</span>
        </div>
        <p class="text-xs text-gray-500">南京大学 · 新闻与传播（数字营销方向）</p>
      </div>
    </footer>

    <script>
      document.getElementById('menu-toggle')?.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>