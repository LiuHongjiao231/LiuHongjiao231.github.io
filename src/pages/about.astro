---
import Layout from '../layouts/Layout.astro';
---
<Layout title="关于我">
  <main class="min-h-screen">
    <header class="border-b border-gray-200 dark:border-gray-800">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-gray-900 dark:text-white">我的作品集</a>
        <div class="flex gap-6">
          <a href="/about" class="hover:text-blue-600 dark:hover:text-blue-400">关于我</a>
          <a href="/projects" class="hover:text-blue-600 dark:hover:text-blue-400">项目</a>
        </div>
      </nav>
    </header>
    <section class="max-w-3xl mx-auto px-4 py-20">
      <h1 class="text-4xl font-bold mb-8">关于我</h1>
      <div class="prose dark:prose-invert max-w-none">
        <p class="mb-6 text-lg">
          你好！我是一名开发者，热爱构建有用的东西。
        </p>
        <h2 class="text-2xl font-semibold mt-8 mb-4">技能栈</h2>
        <ul class="list-disc list-inside mb-6 space-y-2">
          <li>前端：HTML, CSS, JavaScript, TypeScript, Astro, React</li>
          <li>样式：Tailwind CSS</li>
          <li>工具：Git, GitHub, VS Code</li>
        </ul>
        <h2 class="text-2xl font-semibold mt-8 mb-4">经历</h2>
        <ul class="list-disc list-inside space-y-2">
          <li>2024 - 至今：全栈开发学习中</li>
        </ul>
      </div>
    </section>
    <footer class="border-t border-gray-200 dark:border-gray-800 py-8 text-center text-gray-500 dark:text-gray-400">
      <p>© 2024 我的作品集。基于 Astro + Tailwind 构建。</p>
    </footer>
  </main>
</Layout>