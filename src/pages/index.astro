---
import Layout from '../layouts/Layout.astro';
---
<Layout title="首页">

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-indigo-50 via-white to-rose-50 py-24 md:py-32">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl">
        <p class="text-indigo-600 font-medium mb-3">南京大学 · 新闻与传播（数字营销方向）</p>
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-4 leading-tight">刘红娇</h1>
        <p class="text-xl md:text-2xl text-gray-500 mb-8">在数字浪潮中，用内容连接人与品牌</p>
        <div class="flex flex-wrap gap-3 mb-10">
          <span class="px-4 py-2 bg-indigo-100 text-indigo-700 rounded-full text-sm font-medium">文案策划</span>
          <span class="px-4 py-2 bg-rose-100 text-rose-700 rounded-full text-sm font-medium">数据分析</span>
          <span class="px-4 py-2 bg-amber-100 text-amber-700 rounded-full text-sm font-medium">视觉设计</span>
          <span class="px-4 py-2 bg-emerald-100 text-emerald-700 rounded-full text-sm font-medium">视频剪辑</span>
          <span class="px-4 py-2 bg-sky-100 text-sky-700 rounded-full text-sm font-medium">社交媒体运营</span>
        </div>
        <div class="flex gap-4">
          <a href="/marketing" class="px-6 py-3 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition">查看作品</a>
          <a href="/about" class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition">关于我</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-center mb-12">数据概览</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="text-center p-6 bg-indigo-50 rounded-xl">
          <p class="text-3xl md:text-4xl font-bold text-indigo-600">1680万</p>
          <p class="text-sm text-gray-500 mt-2">好客山东 累计播放量</p>
        </div>
        <div class="text-center p-6 bg-rose-50 rounded-xl">
          <p class="text-3xl md:text-4xl font-bold text-rose-600">45万</p>
          <p class="text-sm text-gray-500 mt-2">好客山东 累计点赞</p>
        </div>
        <div class="text-center p-6 bg-amber-50 rounded-xl">
          <p class="text-3xl md:text-4xl font-bold text-amber-600">1.2万+</p>
          <p class="text-sm text-gray-500 mt-2">小红书 总赞藏</p>
        </div>
        <div class="text-center p-6 bg-emerald-50 rounded-xl">
          <p class="text-3xl md:text-4xl font-bold text-emerald-600">16.4万</p>
          <p class="text-sm text-gray-500 mt-2">B站 累计播放量</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What I Do Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-center mb-12">我能做什么</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <a href="/marketing" class="group p-8 bg-white rounded-2xl border border-gray-100 hover:shadow-lg hover:border-indigo-200 transition">
          <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-indigo-200 transition">
            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2">营销运营</h3>
          <p class="text-gray-500 text-sm">小红书/B站/抖音账号运营，从0到1搭建，数据驱动增长，打造爆款内容</p>
        </a>
        <a href="/skills" class="group p-8 bg-white rounded-2xl border border-gray-100 hover:shadow-lg hover:border-rose-200 transition">
          <div class="w-12 h-12 bg-rose-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-rose-200 transition">
            <svg class="w-6 h-6 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2">视觉设计</h3>
          <p class="text-gray-500 text-sm">PS/AI/醒图/可画，平面设计、公众号排版、海报制作、摄影摄像</p>
        </a>
        <a href="/academic" class="group p-8 bg-white rounded-2xl border border-gray-100 hover:shadow-lg hover:border-amber-200 transition">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-amber-200 transition">
            <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <h3 class="text-lg font-bold mb-2">学术研究</h3>
          <p class="text-gray-500 text-sm">问卷调查、深度访谈、网络民族志，独立完成学术研究与论文写作</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Highlight Section -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-center mb-12">亮点项目</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Internship Highlight -->
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-500 to-indigo-700 p-8 text-white">
          <p class="text-sm font-medium text-indigo-200 mb-2">实习经历</p>
          <h3 class="text-2xl font-bold mb-3">好客山东 · 内容运营</h3>
          <p class="text-indigo-100 mb-6">山东省文化和旅游厅官方账号，实习期间产出图文+视频作品 36 个，累计播放量 1680 万，点赞 45 万。</p>
          <a href="/marketing" class="inline-flex items-center gap-2 text-sm font-medium bg-white/20 px-4 py-2 rounded-lg hover:bg-white/30 transition">
            查看详情
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <!-- Research Highlight -->
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-rose-500 to-rose-700 p-8 text-white">
          <p class="text-sm font-medium text-rose-200 mb-2">学术研究</p>
          <h3 class="text-2xl font-bold mb-3">数字劳动者研究</h3>
          <p class="text-rose-100 mb-6">聚焦平台PPT设计师的数字劳动特征与生存困境，运用问卷调查+深度访谈+网络民族志的混合研究方法。</p>
          <a href="/academic" class="inline-flex items-center gap-2 text-sm font-medium bg-white/20 px-4 py-2 rounded-lg hover:bg-white/30 transition">
            查看详情
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>