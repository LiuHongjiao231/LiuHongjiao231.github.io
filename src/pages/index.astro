---
import Layout from '../layouts/Layout.astro';
---
<Layout title="首页">
  <main class="min-h-screen">
    <header class="border-b border-gray-200 dark:border-gray-800">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-gray-900 dark:text-white">我的作品集</a>
        <div class="flex gap-6">
          <a href="/about" class="hover:text-blue-600 dark:hover:text-blue-400">关于我</a>
          <a href="/projects" class="hover:text-blue-600 dark:hover:text-blue-400">项目</a>
        </div>
      </nav>
    </header>
    <section class="max-w-6xl mx-auto px-4 py-20 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6">你好，我是开发者</h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
        欢迎来到我的个人网站。这里展示我的项目、技能和经历。
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/projects" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">查看项目</a>
        <a href="/about" class="border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 px-6 py-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition">关于我</a>
      </div>
    </section>
    <footer class="border-t border-gray-200 dark:border-gray-800 py-8 text-center text-gray-500 dark:text-gray-400">
      <p>© 2024 我的作品集。基于 Astro + Tailwind 构建。</p>
    </footer>
  </main>
</Layout>